{
  "description": "specialist hooks: spec-gate (edits outside the plan — blocked), secrets-guard (secrets at the git boundary — blocked), vuln-guard (semgrep on commit), suite-gate (a red test suite from .suite-gate blocks the commit — opt-in), edit-guard (after an edit: boundary notes, formatter, linter, and an opt-in semgrep scan — one adapter, one deterministic order), git-watch (after tree-changing git operations, signals about stale derived artifacts), plan-context (plan context at session start), codestyle-reminder (a stale CODESTYLE.md reminder, never blocks), kb-gate (the documentation index diverged from disk — blocked), skill-gate (blocks pipeline stage skills under the fast profile, and out-of-role skills when .spec-gate pins role — the block points to the dispatch protocol). Timeouts mirror hooks-codex.json: a hung formatter/linter/semgrep/test suite must never stall a turn (the command-hook default is much higher).",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/lib/spec-gate.mjs\"",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/lib/skill-gate.mjs\"",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/lib/secrets-guard.mjs\"",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/lib/vuln-guard.mjs\"",
            "timeout": 120
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/lib/suite-gate.mjs\"",
            "timeout": 600
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/lib/git-watch.mjs\"",
            "timeout": 120
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/lib/edit-guard.mjs\"",
            "timeout": 240
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/lib/plan-context.mjs\"",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/lib/codestyle-reminder.mjs\"",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/lib/kb-gate.mjs\"",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
